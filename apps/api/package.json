{
  "name": "@akp/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@akp/audit-export": "*",
    "@akp/compiler": "*",
    "@akp/contracts": "*",
    "@akp/evaluation": "*",
    "@akp/git-store": "*",
    "@akp/indexing": "*",
    "@akp/object-store": "*",
    "@akp/observability": "*",
    "@akp/postgres": "*",
    "@akp/project-adapter": "*",
    "@akp/retrieval": "*",
    "@akp/validation": "*",
    "@akp/vault-importer": "*",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "fastify": "^5.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
