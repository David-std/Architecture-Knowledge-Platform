{
  "name": "architecture-knowledge-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "turbo run dev --parallel",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "turbo run test -- --exclude \"**/dist/**\"",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "db:migrate": "tsx scripts/migrate.ts",
    "auth:provision": "tsx scripts/provision-local-token.ts",
    "akp": "tsx apps/cli/src/main.ts",
    "verify:runtime": "tsx scripts/verify-runtime.ts",
    "test:mcp": "tsx scripts/mcp-smoke.ts",
    "check": "npm run lint && npm run typecheck && npm run boundaries && npm run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "boundaries": "depcruise --config dependency-cruiser.cjs apps packages",
    "security:secrets": "node scripts/scan-secrets.mjs",
    "contracts:validate": "node scripts/validate-contracts.mjs",
    "docs:validate": "node scripts/validate-docs.mjs",
    "hygiene:write": "node scripts/validate-repository-hygiene.mjs --write",
    "hygiene:validate": "node scripts/validate-repository-hygiene.mjs",
    "benchmark:capability-baseline": "tsx scripts/capability-maturity-baseline.ts",
    "benchmark:retrieval:offline": "tsx scripts/retrieval_benchmark_offline.ts",
    "benchmark:retrieval:curated": "tsx scripts/retrieval_benchmark_curated.ts",
    "benchmark:retrieval:runtime": "tsx scripts/runtime-retrieval-benchmark.ts",
    "benchmark:retrieval:registered": "tsx scripts/registered-corpus-retrieval-benchmark.ts",
    "benchmark:context-tokenization": "pnpm --filter @akp/retrieval exec tsx scripts/context-tokenizer-baseline.ts",
    "benchmark:context-placement": "pnpm --filter @akp/retrieval exec tsx scripts/context-placement-baseline.ts",
    "benchmark:contextual-chunks": "pnpm --filter @akp/retrieval exec tsx scripts/contextual-chunk-benchmark.ts",
    "proof:baseline-evidence": "tsx scripts/baseline-evidence.ts",
    "benchmark:filtered-ann": "tsx scripts/filtered-ann-baseline.ts",
    "benchmark:agent-ab": "tsx scripts/agent-ab-benchmark.ts",
    "benchmark:agent-context-ergonomics": "pnpm --filter @akp/contracts build && tsx scripts/agent-context-ergonomics-benchmark.ts",
    "benchmark:scale": "node --expose-gc node_modules/tsx/dist/cli.mjs scripts/load-scale-benchmark.ts",
    "benchmark:concurrency": "tsx scripts/concurrency-benchmark.ts",
    "test:browser": "node --test scripts/browser-e2e.test.mjs",
    "benchmark:scale:enterprise": "tsx scripts/enterprise-state-scale-benchmark.ts",
    "proof:capabilities": "tsx scripts/capability-acceptance-matrix.ts",
    "benchmark:agent-arena": "tsx scripts/agent-arena-benchmark.ts",
    "benchmark:competitive": "tsx scripts/competitive-arena-report.ts",
    "proof:upgrade-migrations": "tsx scripts/verify-upgrade-migrations.ts",
    "proof:evidence": "node scripts/final-proof-evidence.mjs",
    "benchmark:domain-quality": "tsx scripts/domain-quality-benchmark.ts",
    "proof:parity-exclusions": "tsx scripts/parity-exclusion-reports.ts",
    "benchmark:registered-graph-code-metrics": "tsx scripts/registered-graph-code-metrics.ts",
    "benchmark:registered-temporal-truth-metrics": "tsx scripts/registered-temporal-truth-metrics.ts",
    "benchmark:registered-workspace-team-metrics": "tsx scripts/registered-workspace-team-metrics.ts",
    "benchmark:registered-retrieval-diagnostics": "tsx scripts/registered-retrieval-diagnostics.ts"
  },
  "devDependencies": {
    "@types/mime-types": "^3.0.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "dependency-cruiser": "^16.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10",
    "playwright": "1.63.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "mime-types": "^3.0.2",
    "minio": "^8.0.7",
    "pg": "^8.13.0",
    "yaml": "^2.9.0"
  }
}
