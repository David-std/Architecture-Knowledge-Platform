{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akp.local/schemas/context-packet-0.3.0.json",
  "title": "Architecture Knowledge Platform ContextPacket",
  "$defs": {
    "GraphRelationType": {
      "type": "string",
      "enum": [
        "derives_from",
        "supports",
        "contradicts",
        "supersedes",
        "implements",
        "applies_to",
        "example_of",
        "counterexample_of",
        "uses",
        "requires",
        "validated_by",
        "produces",
        "consumed_by",
        "related_to"
      ]
    },
    "GraphPathNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentId", "document"],
      "properties": {
        "documentId": { "type": "string", "format": "uuid" },
        "document": { "type": "string", "minLength": 1 },
        "relation": { "$ref": "#/$defs/GraphRelationType" },
        "direction": {
          "type": "string",
          "enum": ["outgoing", "incoming"]
        }
      }
    },
    "GraphPathProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "seedDocumentId",
        "targetDocumentId",
        "path",
        "hops",
        "graphScore"
      ],
      "properties": {
        "channel": { "type": "string", "const": "graph" },
        "seedDocumentId": { "type": "string", "format": "uuid" },
        "targetDocumentId": { "type": "string", "format": "uuid" },
        "path": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/GraphPathNode" }
        },
        "hops": { "type": "integer", "minimum": 1 },
        "graphScore": { "type": "number", "minimum": 0 }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packetId",
    "query",
    "intent",
    "scope",
    "corpusRevision",
    "status",
    "indexRevisions",
    "retrievalConfiguration",
    "generatedAt",
    "budget",
    "mode",
    "sections",
    "citations",
    "gaps",
    "conflicts",
    "requiredActions",
    "continuations",
    "packetHash"
  ],
  "properties": {
    "packetId": { "type": "string", "format": "uuid" },
    "vaultId": { "type": "string", "format": "uuid" },
    "query": { "type": "string", "minLength": 1 },
    "intent": { "type": "string" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spaceId", "vaultIds", "federated"],
      "properties": {
        "organizationId": { "type": "string", "format": "uuid" },
        "spaceId": { "type": "string", "format": "uuid" },
        "vaultIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "format": "uuid" }
        },
        "federated": { "type": "boolean" }
      }
    },
    "corpusRevision": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["SUPPORTED", "INSUFFICIENT_KNOWLEDGE", "DEGRADED"]
    },
    "indexRevisions": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "null"]
      }
    },
    "retrievalConfiguration": {
      "type": "object",
      "additionalProperties": true
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxTokens", "usedTokens"],
      "properties": {
        "maxTokens": { "type": "integer", "minimum": 1 },
        "usedTokens": { "type": "integer", "minimum": 0 }
      }
    },
    "mode": {
      "type": "string",
      "enum": [
        "COMPILED_ONLY",
        "SOURCE_BACKED",
        "RAW_ONLY",
        "PROJECT_CODE",
        "DRAFT_INCLUDED"
      ]
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "title",
          "content",
          "documentId",
          "vaultId",
          "documentRevision",
          "selectionReason",
          "sourceOrEvidenceIds"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "rule",
              "workflow",
              "concept",
              "profile",
              "decision",
              "example",
              "counterexample",
              "evidence",
              "source"
            ]
          },
          "title": { "type": "string" },
          "content": { "type": "string" },
          "documentId": { "type": "string", "format": "uuid" },
          "vaultId": { "type": "string", "format": "uuid" },
          "unitId": { "type": "string", "format": "uuid" },
          "parentUnitId": { "type": "string", "format": "uuid" },
          "unitType": { "type": "string" },
          "retrievalChannels": {
            "type": "array",
            "items": { "type": "string" }
          },
          "documentRevision": { "type": "string" },
          "score": { "type": "number" },
          "selectionReason": { "type": "string" },
          "sourceOrEvidenceIds": {
            "type": "array",
            "items": { "type": "string" }
          },
          "graphProvenance": {
            "type": "array",
            "items": { "$ref": "#/$defs/GraphPathProvenance" }
          }
        }
      }
    },
    "citations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "gaps": {
      "type": "array",
      "items": { "type": "string" }
    },
    "conflicts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "requiredActions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "continuations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["handle", "reason", "remainingTokens"],
        "properties": {
          "handle": { "type": "string", "minLength": 1 },
          "reason": { "type": "string" },
          "remainingTokens": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "packetHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
