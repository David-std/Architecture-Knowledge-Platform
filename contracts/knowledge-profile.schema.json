{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akp.local/contracts/knowledge-profile.schema.json",
  "title": "AKP KnowledgeProfile v1",
  "description": "Portable input contract for KnowledgeProfileV1. Cross-reference integrity, lifecycle graph validity, safe relative artifact paths and other semantic invariants remain authoritatively enforced by @akp/contracts KnowledgeProfileV1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profileId",
    "version",
    "displayName",
    "knowledgeKinds",
    "lifecycles",
    "evidencePolicies",
    "reviewPolicies",
    "artifactContracts",
    "retrievalPolicy",
    "promotionPolicy",
    "freshnessPolicy"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "profileId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
    },
    "version": { "type": "string", "minLength": 1, "maxLength": 100 },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 200 },
    "knowledgeKinds": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/SemanticName" },
      "additionalProperties": { "$ref": "#/$defs/KnowledgeKindDefinition" }
    },
    "relationTypes": {
      "type": "object",
      "default": {},
      "propertyNames": { "$ref": "#/$defs/SemanticName" },
      "additionalProperties": { "$ref": "#/$defs/RelationDefinition" }
    },
    "lifecycles": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/SemanticName" },
      "additionalProperties": { "$ref": "#/$defs/LifecycleDefinition" }
    },
    "evidencePolicies": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/SemanticName" },
      "additionalProperties": { "$ref": "#/$defs/EvidencePolicyDefinition" }
    },
    "reviewPolicies": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/SemanticName" },
      "additionalProperties": { "$ref": "#/$defs/ReviewPolicyDefinition" }
    },
    "artifactContracts": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/SemanticName" },
      "additionalProperties": { "$ref": "#/$defs/ArtifactContractDefinition" }
    },
    "retrievalPolicy": { "$ref": "#/$defs/RetrievalProfilePolicy" },
    "promotionPolicy": { "$ref": "#/$defs/PromotionPolicyDefinition" },
    "freshnessPolicy": { "$ref": "#/$defs/FreshnessPolicyDefinition" },
    "connectorPolicy": { "$ref": "#/$defs/ConnectorProfilePolicy" },
    "modelRoleConstraints": {
      "type": "array",
      "default": [],
      "items": { "$ref": "#/$defs/ModelRoleConstraint" }
    }
  },
  "$defs": {
    "SemanticName": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "KnowledgeFieldDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "string",
            "markdown",
            "number",
            "boolean",
            "datetime",
            "enum",
            "json"
          ]
        },
        "required": { "type": "boolean", "default": false },
        "enumValues": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "enum" } } },
          "then": { "required": ["enumValues"] },
          "else": { "not": { "required": ["enumValues"] } }
        }
      ]
    },
    "KnowledgeKindDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lifecycle",
        "evidencePolicy",
        "reviewPolicy",
        "artifactContract"
      ],
      "properties": {
        "fields": {
          "type": "object",
          "default": {},
          "additionalProperties": { "$ref": "#/$defs/KnowledgeFieldDefinition" }
        },
        "lifecycle": { "$ref": "#/$defs/SemanticName" },
        "evidencePolicy": { "$ref": "#/$defs/SemanticName" },
        "reviewPolicy": { "$ref": "#/$defs/SemanticName" },
        "artifactContract": { "$ref": "#/$defs/SemanticName" }
      }
    },
    "LifecycleTransitionDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "allowedActors"],
      "properties": {
        "from": { "$ref": "#/$defs/SemanticName" },
        "to": { "$ref": "#/$defs/SemanticName" },
        "allowedActors": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        },
        "requiredEvidence": { "type": "boolean", "default": false },
        "requiredReview": { "type": "boolean", "default": false }
      }
    },
    "LifecycleDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["states", "initial"],
      "properties": {
        "states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/SemanticName" }
        },
        "initial": { "$ref": "#/$defs/SemanticName" },
        "terminal": {
          "type": "array",
          "default": [],
          "items": { "$ref": "#/$defs/SemanticName" }
        },
        "transitions": {
          "type": "array",
          "default": [],
          "items": { "$ref": "#/$defs/LifecycleTransitionDefinition" }
        }
      }
    },
    "EvidencePolicyDefinition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimumEvidence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 1
        },
        "requireSourceLocator": { "type": "boolean", "default": true },
        "minimumTrust": {
          "type": "string",
          "default": "MACHINE_SUPPORTED",
          "enum": [
            "UNVERIFIED",
            "MACHINE_SUPPORTED",
            "HUMAN_REVIEWED",
            "ATTESTED"
          ]
        }
      }
    },
    "ReviewPolicyDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedRoles"],
      "properties": {
        "required": { "type": "boolean", "default": true },
        "minimumApprovals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20,
          "default": 1
        },
        "allowedRoles": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "required": { "const": true } },
            "required": ["required"]
          },
          "then": {
            "properties": { "minimumApprovals": { "minimum": 1 } }
          }
        }
      ]
    },
    "ArtifactContractDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "pathTemplate"],
      "properties": {
        "root": { "type": "string", "minLength": 1, "maxLength": 500 },
        "pathTemplate": { "type": "string", "minLength": 1, "maxLength": 500 },
        "extension": {
          "type": "string",
          "pattern": "^\\.[A-Za-z0-9]+$",
          "default": ".md"
        }
      }
    },
    "RelationDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/SemanticName" }
        },
        "to": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/SemanticName" }
        },
        "symmetric": { "type": "boolean", "default": false },
        "evidenceRequired": { "type": "boolean", "default": false },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "RetrievalProfilePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedKinds"],
      "properties": {
        "allowedKinds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/SemanticName" }
        },
        "relationAllowlist": {
          "type": "array",
          "default": [],
          "items": { "$ref": "#/$defs/SemanticName" }
        },
        "mandatoryKindsByIntent": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "array",
            "items": { "$ref": "#/$defs/SemanticName" }
          }
        },
        "progressiveDisclosure": {
          "type": "array",
          "minItems": 1,
          "default": ["L0", "L1", "L2", "L3"],
          "items": { "type": "string", "enum": ["L0", "L1", "L2", "L3"] }
        }
      }
    },
    "PromotionPolicyDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedTargetScopes"],
      "properties": {
        "allowedTargetScopes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "PERSONAL",
              "PROJECT",
              "TEAM",
              "ORGANIZATION",
              "EXTERNAL_FEDERATED"
            ]
          }
        },
        "reviewRequired": { "type": "boolean", "default": true }
      }
    },
    "FreshnessPolicyDefinition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceChangeAction": {
          "type": "string",
          "default": "MARK_STALE",
          "enum": ["MARK_STALE", "RECOMPILE", "REVIEW_REQUIRED"]
        },
        "staleAfterDays": { "type": "integer", "minimum": 1, "maximum": 36500 }
      }
    },
    "ConnectorProfilePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedAccessModes"],
      "properties": {
        "allowedAccessModes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "MIRROR_INDEXED",
              "REMOTE_FEDERATED",
              "REFERENCE_LIVE",
              "HYBRID_CACHE"
            ]
          }
        },
        "requirePermissionFidelity": { "type": "boolean", "default": true }
      }
    },
    "ModelRoleConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "residency"],
      "properties": {
        "role": { "type": "string", "minLength": 1, "maxLength": 100 },
        "residency": {
          "type": "string",
          "enum": ["LOCAL_ONLY", "ORG_APPROVED", "EXTERNAL_ALLOWED"]
        },
        "structuredOutputRequired": { "type": "boolean", "default": false }
      }
    }
  }
}
