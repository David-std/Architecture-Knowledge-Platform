{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akp.local/contracts/knowledge-profile.schema.json",
  "title": "AKP KnowledgeProfile v1",
  "description": "Portable structural contract for KnowledgeProfileV1. Cross-reference integrity, lifecycle graph validity, enum-field consistency, safe relative artifact paths and other semantic invariants remain authoritatively enforced by @akp/contracts KnowledgeProfileV1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profileId",
    "version",
    "displayName",
    "knowledgeKinds",
    "relationTypes",
    "lifecycles",
    "evidencePolicies",
    "reviewPolicies",
    "artifactContracts",
    "retrievalPolicy",
    "promotionPolicy",
    "freshnessPolicy",
    "modelRoleConstraints"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "profileId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
    },
    "version": { "type": "string", "minLength": 1, "maxLength": 100 },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 200 },
    "knowledgeKinds": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/SemanticName" },
      "additionalProperties": { "$ref": "#/$defs/KnowledgeKindDefinition" }
    },
    "relationTypes": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/SemanticName" },
      "additionalProperties": { "$ref": "#/$defs/RelationDefinition" }
    },
    "lifecycles": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/SemanticName" },
      "additionalProperties": { "$ref": "#/$defs/LifecycleDefinition" }
    },
    "evidencePolicies": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/SemanticName" },
      "additionalProperties": { "$ref": "#/$defs/EvidencePolicyDefinition" }
    },
    "reviewPolicies": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/SemanticName" },
      "additionalProperties": { "$ref": "#/$defs/ReviewPolicyDefinition" }
    },
    "artifactContracts": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/SemanticName" },
      "additionalProperties": { "$ref": "#/$defs/ArtifactContractDefinition" }
    },
    "retrievalPolicy": { "$ref": "#/$defs/RetrievalProfilePolicy" },
    "promotionPolicy": { "$ref": "#/$defs/PromotionPolicyDefinition" },
    "freshnessPolicy": { "$ref": "#/$defs/FreshnessPolicyDefinition" },
    "connectorPolicy": { "$ref": "#/$defs/ConnectorProfilePolicy" },
    "modelRoleConstraints": {
      "type": "array",
      "items": { "$ref": "#/$defs/ModelRoleConstraint" }
    }
  },
  "$defs": {
    "SemanticName": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "KnowledgeFieldDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "required"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["string", "markdown", "number", "boolean", "datetime", "enum", "json"]
        },
        "required": { "type": "boolean" },
        "enumValues": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "KnowledgeKindDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields", "lifecycle", "evidencePolicy", "reviewPolicy", "artifactContract"],
      "properties": {
        "fields": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/KnowledgeFieldDefinition" }
        },
        "lifecycle": { "$ref": "#/$defs/SemanticName" },
        "evidencePolicy": { "$ref": "#/$defs/SemanticName" },
        "reviewPolicy": { "$ref": "#/$defs/SemanticName" },
        "artifactContract": { "$ref": "#/$defs/SemanticName" }
      }
    },
    "LifecycleTransitionDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "allowedActors", "requiredEvidence", "requiredReview"],
      "properties": {
        "from": { "$ref": "#/$defs/SemanticName" },
        "to": { "$ref": "#/$defs/SemanticName" },
        "allowedActors": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        },
        "requiredEvidence": { "type": "boolean" },
        "requiredReview": { "type": "boolean" }
      }
    },
    "LifecycleDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["states", "initial", "terminal", "transitions"],
      "properties": {
        "states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/SemanticName" }
        },
        "initial": { "$ref": "#/$defs/SemanticName" },
        "terminal": {
          "type": "array",
          "items": { "$ref": "#/$defs/SemanticName" }
        },
        "transitions": {
          "type": "array",
          "items": { "$ref": "#/$defs/LifecycleTransitionDefinition" }
        }
      }
    },
    "EvidencePolicyDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumEvidence", "requireSourceLocator", "minimumTrust"],
      "properties": {
        "minimumEvidence": { "type": "integer", "minimum": 0, "maximum": 100 },
        "requireSourceLocator": { "type": "boolean" },
        "minimumTrust": {
          "type": "string",
          "enum": ["UNVERIFIED", "MACHINE_SUPPORTED", "HUMAN_REVIEWED", "ATTESTED"]
        }
      }
    },
    "ReviewPolicyDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "minimumApprovals", "allowedRoles"],
      "properties": {
        "required": { "type": "boolean" },
        "minimumApprovals": { "type": "integer", "minimum": 0, "maximum": 20 },
        "allowedRoles": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        }
      }
    },
    "ArtifactContractDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "pathTemplate", "extension"],
      "properties": {
        "root": { "type": "string", "minLength": 1, "maxLength": 500 },
        "pathTemplate": { "type": "string", "minLength": 1, "maxLength": 500 },
        "extension": { "type": "string", "pattern": "^\\.[A-Za-z0-9]+$" }
      }
    },
    "RelationDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "symmetric", "evidenceRequired"],
      "properties": {
        "from": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/SemanticName" }
        },
        "to": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/SemanticName" }
        },
        "symmetric": { "type": "boolean" },
        "evidenceRequired": { "type": "boolean" },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "RetrievalProfilePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedKinds", "relationAllowlist", "mandatoryKindsByIntent", "progressiveDisclosure"],
      "properties": {
        "allowedKinds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/SemanticName" }
        },
        "relationAllowlist": {
          "type": "array",
          "items": { "$ref": "#/$defs/SemanticName" }
        },
        "mandatoryKindsByIntent": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "$ref": "#/$defs/SemanticName" }
          }
        },
        "progressiveDisclosure": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["L0", "L1", "L2", "L3"] }
        }
      }
    },
    "PromotionPolicyDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedTargetScopes", "reviewRequired"],
      "properties": {
        "allowedTargetScopes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["PERSONAL", "PROJECT", "TEAM", "ORGANIZATION", "EXTERNAL_FEDERATED"]
          }
        },
        "reviewRequired": { "type": "boolean" }
      }
    },
    "FreshnessPolicyDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceChangeAction"],
      "properties": {
        "sourceChangeAction": {
          "type": "string",
          "enum": ["MARK_STALE", "RECOMPILE", "REVIEW_REQUIRED"]
        },
        "staleAfterDays": { "type": "integer", "minimum": 1, "maximum": 36500 }
      }
    },
    "ConnectorProfilePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedAccessModes", "requirePermissionFidelity"],
      "properties": {
        "allowedAccessModes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["MIRROR_INDEXED", "REMOTE_FEDERATED", "REFERENCE_LIVE", "HYBRID_CACHE"]
          }
        },
        "requirePermissionFidelity": { "type": "boolean" }
      }
    },
    "ModelRoleConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "residency", "structuredOutputRequired"],
      "properties": {
        "role": { "type": "string", "minLength": 1, "maxLength": 100 },
        "residency": {
          "type": "string",
          "enum": ["LOCAL_ONLY", "ORG_APPROVED", "EXTERNAL_ALLOWED"]
        },
        "structuredOutputRequired": { "type": "boolean" }
      }
    }
  }
}
