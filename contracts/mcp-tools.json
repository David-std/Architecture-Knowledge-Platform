    {
      "name": "akp_reindex",
      "version": "1.0.0",
      "permission": "admin",
      "mutates": true,
      "requiresIdempotencyKey": true,
      "description": "Rebuild one explicitly selected authorized vault; admin pathPrefix must be null.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "spaceId",
          "vaultId",
          "confirm",
          "idempotencyKey"
        ],
        "properties": {
          "spaceId": {
            "type": "string",
            "format": "uuid"
          },
          "vaultId": {
            "type": "string",
            "format": "uuid"
          },
          "confirm": {
            "type": "string",
            "enum": [
              "REBUILD_DERIVED_PROJECTIONS",
              "REIMPORT_AND_REBUILD"
            ]
          },
          "reimportVault": {
            "type": "boolean",
            "default": false
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "reimportVault": {
                  "const": true
                }
              },
              "required": [
                "reimportVault"
              ]
            },
            "then": {
              "properties": {
                "confirm": {
                  "const": "REIMPORT_AND_REBUILD"
                }
              }
            }
          },
          {
            "if": {
              "anyOf": [
                {
                  "not": {
                    "required": [
                      "reimportVault"
                    ]
                  }
                },
                {
                  "properties": {
                    "reimportVault": {
                      "const": false
                    }
                  },
                  "required": [
                    "reimportVault"
                  ]
                }
              ]
            },
            "then": {
              "properties": {
                "confirm": {
                  "const": "REBUILD_DERIVED_PROJECTIONS"
                }
              }
            }
          }
        ]
      },
      "http": {
        "method": "POST",
        "path": "/v1/reindex"
      }
    },
