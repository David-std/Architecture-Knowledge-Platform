{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "architecture-knowledge-platform",
  "version": "0.2.0",
  "transports": [
    "stdio",
    "streamable-http"
  ],
  "definitions": {
    "ScopedSearch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query",
        "spaceId",
        "vaultIds"
      ],
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1
        },
        "spaceId": {
          "type": "string",
          "format": "uuid"
        },
        "vaultIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "federated": {
          "type": "boolean",
          "default": false
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 10
        },
        "minimumTrust": {
          "type": "string",
          "enum": [
            "UNVERIFIED",
            "MACHINE_SUPPORTED",
            "HUMAN_REVIEWED",
            "ATTESTED"
          ],
          "default": "MACHINE_SUPPORTED"
        },
        "mode": {
          "type": "string",
          "enum": [
            "COMPILED_ONLY",
            "SOURCE_BACKED",
            "RAW_ONLY",
            "PROJECT_CODE"
          ],
          "default": "SOURCE_BACKED"
        },
        "intent": {
          "type": "string",
          "enum": [
            "EXACT_LOOKUP",
            "CONCEPTUAL",
            "COMPARISON",
            "WORKFLOW_EXECUTION",
            "SOURCE_VERIFICATION",
            "PROJECT_CODE",
            "GLOBAL_SYNTHESIS",
            "IMPACT_ANALYSIS",
            "NO_RETRIEVAL_REQUIRED"
          ]
        }
      }
    },
    "ScopedContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query",
        "spaceId",
        "vaultIds"
      ],
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1
        },
        "spaceId": {
          "type": "string",
          "format": "uuid"
        },
        "vaultIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "federated": {
          "type": "boolean",
          "default": false
        },
        "intent": {
          "type": "string",
          "enum": [
            "EXACT_LOOKUP",
            "CONCEPTUAL",
            "COMPARISON",
            "WORKFLOW_EXECUTION",
            "SOURCE_VERIFICATION",
            "PROJECT_CODE",
            "GLOBAL_SYNTHESIS",
            "IMPACT_ANALYSIS",
            "NO_RETRIEVAL_REQUIRED"
          ],
          "default": "CONCEPTUAL"
        },
        "maxTokens": {
          "type": "integer",
          "minimum": 256,
          "maximum": 32000,
          "default": 6000
        },
        "packetMode": {
          "type": "string",
          "enum": [
            "FULL_CONTEXT_PACKET",
            "COMPACT_AGENT_PACKET"
          ],
          "default": "COMPACT_AGENT_PACKET"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 20
        },
        "mode": {
          "type": "string",
          "enum": [
            "COMPILED_ONLY",
            "SOURCE_BACKED",
            "RAW_ONLY",
            "PROJECT_CODE"
          ],
          "default": "SOURCE_BACKED"
        }
      }
    },
    "CodeSymbolSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "commitSha": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{40}$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "qualifiedName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "signature": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "anyOf": [
        {
          "required": [
            "path"
          ]
        },
        {
          "required": [
            "qualifiedName"
          ]
        },
        {
          "required": [
            "name"
          ]
        },
        {
          "required": [
            "signature"
          ]
        }
      ]
    },
    "CodePathOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "relationTypes": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "maxHops": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "maxFanout": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "maxCandidates": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "timeBudgetMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        }
      }
    },
    "CodeImpactOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "relationTypes": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "maxHops": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "maxFanout": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "maxCandidates": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "timeBudgetMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "direction": {
          "type": "string",
          "enum": [
            "outgoing",
            "incoming",
            "both"
          ]
        },
        "includeTests": {
          "type": "boolean"
        },
        "includeCatalogBridges": {
          "type": "boolean"
        },
        "includeRulesDecisions": {
          "type": "boolean"
        },
        "includeRuntimeObservations": {
          "type": "boolean"
        }
      }
    },
    "CodeScopedSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spaceId",
        "selector"
      ],
      "properties": {
        "spaceId": {
          "type": "string",
          "format": "uuid"
        },
        "vaultId": {
          "type": "string",
          "format": "uuid"
        },
        "vaultIds": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "federated": {
          "type": "boolean",
          "default": false
        },
        "freshnessPolicy": {
          "type": "string",
          "enum": [
            "FRESH_ONLY",
            "ALLOW_STALE"
          ],
          "default": "FRESH_ONLY"
        },
        "selector": {
          "$ref": "#/definitions/CodeSymbolSelector"
        }
      }
    },
    "CodeScopedPath": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spaceId",
        "source",
        "target"
      ],
      "properties": {
        "spaceId": {
          "type": "string",
          "format": "uuid"
        },
        "vaultId": {
          "type": "string",
          "format": "uuid"
        },
        "vaultIds": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "federated": {
          "type": "boolean",
          "default": false
        },
        "freshnessPolicy": {
          "type": "string",
          "enum": [
            "FRESH_ONLY",
            "ALLOW_STALE"
          ],
          "default": "FRESH_ONLY"
        },
        "source": {
          "$ref": "#/definitions/CodeSymbolSelector"
        },
        "target": {
          "$ref": "#/definitions/CodeSymbolSelector"
        },
        "options": {
          "$ref": "#/definitions/CodePathOptions"
        }
      }
    },
    "CodeScopedImpact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spaceId",
        "selector"
      ],
      "properties": {
        "spaceId": {
          "type": "string",
          "format": "uuid"
        },
        "vaultId": {
          "type": "string",
          "format": "uuid"
        },
        "vaultIds": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "federated": {
          "type": "boolean",
          "default": false
        },
        "freshnessPolicy": {
          "type": "string",
          "enum": [
            "FRESH_ONLY",
            "ALLOW_STALE"
          ],
          "default": "FRESH_ONLY"
        },
        "selector": {
          "$ref": "#/definitions/CodeSymbolSelector"
        },
        "options": {
          "$ref": "#/definitions/CodeImpactOptions"
        }
      }
    },
    "CodeScopedChangeImpact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spaceId",
        "repository",
        "commitSha",
        "changedPaths"
      ],
      "properties": {
        "spaceId": {
          "type": "string",
          "format": "uuid"
        },
        "vaultId": {
          "type": "string",
          "format": "uuid"
        },
        "vaultIds": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "federated": {
          "type": "boolean",
          "default": false
        },
        "freshnessPolicy": {
          "type": "string",
          "enum": [
            "FRESH_ONLY",
            "ALLOW_STALE"
          ],
          "default": "FRESH_ONLY"
        },
        "repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "commitSha": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{40}$"
        },
        "changedPaths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "options": {
          "$ref": "#/definitions/CodeImpactOptions"
        }
      }
    }
  },
  "tools": [
    {
      "name": "akp_status",
      "version": "1.0.0",
      "permission": "knowledge:read",
      "mutates": false,
      "http": {
        "method": "GET",
        "path": "/v1/status"
      }
    },
    {
      "name": "akp_get_current_identity",
      "version": "1.0.0",
      "permission": "knowledge:read",
      "mutates": false,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "http": {
        "method": "GET",
        "path": "/v1/auth/session"
      }
    },
    {
      "name": "akp_list_vaults",
      "version": "1.0.0",
      "permission": "knowledge:read",
      "mutates": false,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "http": {
        "method": "GET",
        "path": "/v1/vaults"
      }
    },
    {
      "name": "akp_start_session",
      "version": "1.0.0",
      "permission": "knowledge:read",
      "mutates": true,
      "requiresIdempotencyKey": true,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "spaceId",
          "vaultId",
          "purpose",
          "idempotencyKey"
        ],
        "properties": {
          "spaceId": {
            "type": "string",
            "format": "uuid"
          },
          "vaultId": {
            "type": "string",
            "format": "uuid"
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "contextBudget": {
            "type": "integer",
            "minimum": 256,
            "maximum": 32000
          },
          "projectId": {
            "type": "string",
            "format": "uuid"
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200
          }
        }
      },
      "http": {
        "method": "POST",
        "path": "/v1/sessions"
      }
    },
    {
      "name": "akp_list_sessions",
      "version": "1.0.0",
      "permission": "knowledge:read",
      "mutates": false,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "http": {
        "method": "GET",
        "path": "/v1/sessions"
      }
    },
    {
      "name": "akp_get_session_state",
      "version": "1.0.0",
      "permission": "knowledge:read",
      "mutates": false,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sessionId"
        ],
        "properties": {
          "sessionId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "http": {
        "method": "GET",
        "path": "/v1/sessions/{id}/state"
      }
    },
    {
      "name": "akp_update_work_context",
      "version": "1.0.0",
      "permission": "knowledge:read",
      "mutates": true,
      "requiresIdempotencyKey": true,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sessionId",
          "status",
          "idempotencyKey"
        ],
        "properties": {
          "sessionId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "OPEN",
              "BLOCKED",
              "COMPLETED",
              "ABANDONED"
            ]
          },
          "outcome": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 12000
          },
          "followUps": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "touchedResources": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200
          }
        }
      },
      "http": {
        "method": "POST",
        "path": "/v1/sessions/{id}/work-context"
      }
    },
    {
      "name": "akp_bootstrap_session_context",
      "version": "1.0.0",
      "permission": "knowledge:read",
      "mutates": false,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sessionId"
        ],
        "properties": {
          "sessionId": {
            "type": "string",
            "format": "uuid"
          },
          "query": {
            "type": "string",
            "maxLength": 4096
          },
          "intent": {
            "type": "string",
            "default": "WORKFLOW_EXECUTION",
            "enum": [
              "EXACT_LOOKUP",
              "CONCEPTUAL",
              "COMPARISON",
              "WORKFLOW_EXECUTION",
              "SOURCE_VERIFICATION",
              "PROJECT_CODE",
              "GLOBAL_SYNTHESIS",
              "IMPACT_ANALYSIS",
              "NO_RETRIEVAL_REQUIRED"
            ]
          },
          "packetMode": {
            "type": "string",
            "default": "COMPACT_AGENT_PACKET",
            "enum": [
              "COMPACT_AGENT_PACKET",
              "FULL_CONTEXT_PACKET"
            ]
          }
        }
      },
      "http": {
        "method": "POST",
        "path": "/v1/sessions/{id}/bootstrap"
      }
    },
    {
      "name": "akp_claim_workspace_work",
      "version": "1.0.0",
      "permission": "knowledge:read",
      "mutates": true,
      "requiresIdempotencyKey": true,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sessionId",
          "workKey",
          "idempotencyKey"
        ],
        "properties": {
          "sessionId": {
            "type": "string",
            "format": "uuid"
          },
          "workKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "leaseSeconds": {
            "type": "integer",
            "minimum": 15,
            "maximum": 900,
            "default": 120
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200
          }
        }
      },
      "http": {
        "method": "POST",
        "path": "/v1/sessions/{id}/claims"
      }
    },
    {
      "name": "akp_heartbeat_workspace_claim",
      "version": "1.0.0",
      "permission": "knowledge:read",
      "mutates": true,
      "requiresIdempotencyKey": true,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sessionId",
          "workKey",
          "fencingToken",
          "idempotencyKey"
        ],
        "properties": {
          "sessionId": {
            "type": "string",
            "format": "uuid"
          },
          "workKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "fencingToken": {
            "type": "integer",
            "minimum": 1
          },
          "leaseSeconds": {
            "type": "integer",
            "minimum": 15,
            "maximum": 900,
            "default": 120
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200
          }
        }
      },
      "http": {
        "method": "POST",
        "path": "/v1/sessions/{id}/claims/heartbeat"
      }
    },
    {
      "name": "akp_release_workspace_claim",
      "version": "1.0.0",
      "permission": "knowledge:read",
      "mutates": true,
      "requiresIdempotencyKey": true,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sessionId",
          "workKey",
          "fencingToken",
          "idempotencyKey"
        ],
        "properties": {
          "sessionId": {
            "type": "string",
            "format": "uuid"
          },
          "workKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "fencingToken": {
            "type": "integer",
            "minimum": 1
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200
          }
        }
      },
      "http": {
        "method": "POST",
        "path": "/v1/sessions/{id}/claims/release"
      }
    },
    {
      "name": "akp_handoff_workspace_claim",
      "version": "1.0.0",
      "permission": "knowledge:read",
      "mutates": true,
      "requiresIdempotencyKey": true,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sessionId",
          "workKey",
          "toUserId",
          "fencingToken",
          "idempotencyKey"
        ],
        "properties": {
          "sessionId": {
            "type": "string",
            "format": "uuid"
          },
          "workKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "toUserId": {
            "type": "string",
            "format": "uuid"
          },
          "toPrincipalId": {
            "type": "string",
            "format": "uuid",
            "description": "Optional exact target principal for agent-to-agent handoff."
          },
          "fencingToken": {
            "type": "integer",
            "minimum": 1
          },
          "leaseSeconds": {
            "type": "integer",
            "minimum": 15,
            "maximum": 900,
            "default": 120
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "completed": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "remaining": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "blockers": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "changedResourceRefs": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "evidenceRefs": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "questions": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "note": {
            "type": "string",
            "maxLength": 2048,
            "description": "Legacy compatibility note; prefer structured handoff fields."
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200
          }
        }
      },
      "http": {
        "method": "POST",
        "path": "/v1/sessions/{id}/claims/handoff"
      }
    },
    {
      "name": "akp_append_workspace_event",
      "version": "1.0.0",
      "permission": "knowledge:read",
      "mutates": true,
      "requiresIdempotencyKey": true,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sessionId",
          "eventType",
          "idempotencyKey"
        ],
        "properties": {
          "sessionId": {
            "type": "string",
            "format": "uuid"
          },
          "eventType": {
            "type": "string",
            "enum": [
              "FINDING",
              "BLOCKER",
              "QUESTION",
              "ARTIFACT",
              "DECISION_CANDIDATE",
              "NOTE"
            ]
          },
          "claimId": {
            "type": "string",
            "format": "uuid",
            "description": "Optional owning claim; requires the matching fencingToken."
          },
          "fencingToken": {
            "type": "integer",
            "minimum": 1,
            "description": "Required together with claimId."
          },
          "payload": {
            "type": "object",
