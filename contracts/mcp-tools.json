{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "architecture-knowledge-platform",
  "version": "0.2.0",
  "transports": ["stdio", "streamable-http"],
  "definitions": {
    "ScopedSearch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query", "spaceId", "vaultIds"],
      "properties": {
        "query": { "type": "string", "minLength": 1 },
        "spaceId": { "type": "string", "format": "uuid" },
        "vaultIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "type": "string", "format": "uuid" }
        },
        "federated": { "type": "boolean", "default": false },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 10
        },
        "minimumTrust": {
          "type": "string",
          "enum": [
            "UNVERIFIED",
            "MACHINE_SUPPORTED",
            "HUMAN_REVIEWED",
            "ATTESTED"
          ],
          "default": "MACHINE_SUPPORTED"
        },
        "mode": {
          "type": "string",
          "enum": [
            "COMPILED_ONLY",
            "SOURCE_BACKED",
            "RAW_ONLY",
            "PROJECT_CODE"
          ],
          "default": "SOURCE_BACKED"
        },
        "intent": {
          "type": "string",
          "enum": [
            "EXACT_LOOKUP",
            "CONCEPTUAL",
            "COMPARISON",
            "WORKFLOW_EXECUTION",
            "SOURCE_VERIFICATION",
            "PROJECT_CODE",
            "GLOBAL_SYNTHESIS",
            "IMPACT_ANALYSIS",
            "NO_RETRIEVAL_REQUIRED"
          ]
        }
      }
    },
    "ScopedContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query", "spaceId", "vaultIds"],
      "properties": {
        "query": { "type": "string", "minLength": 1 },
        "spaceId": { "type": "string", "format": "uuid" },
        "vaultIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "type": "string", "format": "uuid" }
        },
        "federated": { "type": "boolean", "default": false },
        "intent": {
          "type": "string",
          "enum": [
            "EXACT_LOOKUP",
            "CONCEPTUAL",
            "COMPARISON",
            "WORKFLOW_EXECUTION",
            "SOURCE_VERIFICATION",
            "PROJECT_CODE",
            "GLOBAL_SYNTHESIS",
            "IMPACT_ANALYSIS",
            "NO_RETRIEVAL_REQUIRED"
          ],
          "default": "CONCEPTUAL"
        },
        "maxTokens": {
          "type": "integer",
          "minimum": 256,
          "maximum": 32000,
          "default": 6000
        },
        "packetMode": {
          "type": "string",
          "enum": ["FULL_CONTEXT_PACKET", "COMPACT_AGENT_PACKET"],
          "default": "COMPACT_AGENT_PACKET"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 20
        },
        "mode": {
          "type": "string",
          "enum": [
            "COMPILED_ONLY",
            "SOURCE_BACKED",
            "RAW_ONLY",
            "PROJECT_CODE"
          ],
          "default": "SOURCE_BACKED"
        }
      }
    }
  },
  "tools": [
    {
      "name": "akp_status",
      "version": "1.0.0",
      "permission": "knowledge:read",
      "mutates": false,
      "http": { "method": "GET", "path": "/v1/status" }
    },
    {
      "name": "akp_list_vaults",
      "version": "1.0.0",
      "permission": "knowledge:read",
      "mutates": false,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "http": { "method": "GET", "path": "/v1/vaults" }
    },
    {
      "name": "akp_start_session",
      "version": "1.0.0",
      "permission": "knowledge:read",
      "mutates": true,
      "requiresIdempotencyKey": true,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["spaceId", "vaultId", "purpose", "idempotencyKey"],
        "properties": {
          "spaceId": { "type": "string", "format": "uuid" },
          "vaultId": { "type": "string", "format": "uuid" },
          "purpose": { "type": "string", "minLength": 1 },
          "contextBudget": {
            "type": "integer",
            "minimum": 256,
            "maximum": 32000
          },
          "projectId": { "type": "string", "format": "uuid" },
          "idempotencyKey": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200
          }
        }
      },
      "http": { "method": "POST", "path": "/v1/sessions" }
    },
    {
      "name": "akp_list_sessions",
      "version": "1.0.0",
      "permission": "knowledge:read",
      "mutates": false,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "http": { "method": "GET", "path": "/v1/sessions" }
    },
    {
      "name": "akp_get_session_state",
      "version": "1.0.0",
      "permission": "knowledge:read",
      "mutates": false,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sessionId"],
        "properties": {
          "sessionId": { "type": "string", "format": "uuid" }
        }
      },
      "http": { "method": "GET", "path": "/v1/sessions/{id}/state" }
    },
    {
      "name": "akp_bootstrap_session_context",
      "version": "1.0.0",
      "permission": "knowledge:read",
      "mutates": false,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sessionId"],
        "properties": {
          "sessionId": { "type": "string", "format": "uuid" },
          "query": { "type": "string", "maxLength": 4096 },
          "intent": {
            "type": "string",
            "default": "WORKFLOW_EXECUTION",
            "enum": [
              "EXACT_LOOKUP",
              "CONCEPTUAL",
              "COMPARISON",
              "WORKFLOW_EXECUTION",
              "SOURCE_VERIFICATION",
              "PROJECT_CODE",
              "GLOBAL_SYNTHESIS",
              "IMPACT_ANALYSIS",
              "NO_RETRIEVAL_REQUIRED"
            ]
          },
          "packetMode": {
            "type": "string",
            "default": "COMPACT_AGENT_PACKET",
            "enum": ["COMPACT_AGENT_PACKET", "FULL_CONTEXT_PACKET"]
          }
        }
      },
      "http": { "method": "POST", "path": "/v1/sessions/{id}/bootstrap" }
    },
    {
      "name": "akp_claim_workspace_work",
      "version": "1.0.0",
      "permission": "knowledge:read",
      "mutates": true,
      "requiresIdempotencyKey": true,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sessionId", "workKey", "idempotencyKey"],
        "properties": {
          "sessionId": { "type": "string", "format": "uuid" },
          "workKey": { "type": "string", "minLength": 1, "maxLength": 200 },
          "leaseSeconds": {
            "type": "integer",
            "minimum": 15,
            "maximum": 900,
            "default": 120
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200
          }
        }
      },
      "http": { "method": "POST", "path": "/v1/sessions/{id}/claims" }
    },
    {
      "name": "akp_heartbeat_workspace_claim",
      "version": "1.0.0",
      "permission": "knowledge:read",
      "mutates": true,
      "requiresIdempotencyKey": true,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sessionId", "workKey", "fencingToken", "idempotencyKey"],
        "properties": {
          "sessionId": { "type": "string", "format": "uuid" },
          "workKey": { "type": "string", "minLength": 1, "maxLength": 200 },
          "fencingToken": { "type": "integer", "minimum": 1 },
          "leaseSeconds": {
            "type": "integer",
            "minimum": 15,
            "maximum": 900,
            "default": 120
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200
          }
        }
      },
      "http": { "method": "POST", "path": "/v1/sessions/{id}/claims/heartbeat" }
    },
    {
      "name": "akp_release_workspace_claim",
      "version": "1.0.0",
      "permission": "knowledge:read",
      "mutates": true,
      "requiresIdempotencyKey": true,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sessionId", "workKey", "fencingToken", "idempotencyKey"],
        "properties": {
          "sessionId": { "type": "string", "format": "uuid" },
          "workKey": { "type": "string", "minLength": 1, "maxLength": 200 },
          "fencingToken": { "type": "integer", "minimum": 1 },
          "idempotencyKey": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200
          }
        }
      },
      "http": { "method": "POST", "path": "/v1/sessions/{id}/claims/release" }
    },
    {
      "name": "akp_handoff_workspace_claim",
      "version": "1.0.0",
      "permission": "knowledge:read",
      "mutates": true,
      "requiresIdempotencyKey": true,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sessionId",
          "workKey",
          "toUserId",
          "fencingToken",
          "idempotencyKey"
        ],
        "properties": {
          "sessionId": { "type": "string", "format": "uuid" },
          "workKey": { "type": "string", "minLength": 1, "maxLength": 200 },
          "toUserId": { "type": "string", "format": "uuid" },
          "fencingToken": { "type": "integer", "minimum": 1 },
          "leaseSeconds": {
            "type": "integer",
            "minimum": 15,
            "maximum": 900,
            "default": 120
          },
          "note": { "type": "string", "maxLength": 2048 },
          "idempotencyKey": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200
          }
        }
      },
      "http": { "method": "POST", "path": "/v1/sessions/{id}/claims/handoff" }
    },
    {
      "name": "akp_append_workspace_event",
      "version": "1.0.0",
      "permission": "knowledge:read",
      "mutates": true,
      "requiresIdempotencyKey": true,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sessionId", "eventType", "idempotencyKey"],
        "properties": {
          "sessionId": { "type": "string", "format": "uuid" },
          "eventType": {
            "type": "string",
            "enum": [
              "FINDING",
              "BLOCKER",
              "QUESTION",
              "ARTIFACT",
              "DECISION_CANDIDATE",
              "NOTE"
            ]
          },
          "payload": { "type": "object", "additionalProperties": true },
          "idempotencyKey": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200
          }
        }
      },
      "http": { "method": "POST", "path": "/v1/sessions/{id}/events" }
    },
    {
      "name": "akp_request_workspace_promotion",
      "version": "1.0.0",
      "permission": "knowledge:propose",
      "mutates": true,
      "requiresIdempotencyKey": true,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sessionId",
          "evidenceEventIds",
          "changes",
          "idempotencyKey"
        ],
        "properties": {
          "sessionId": { "type": "string", "format": "uuid" },
          "evidenceEventIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": { "type": "string", "pattern": "^[1-9][0-9]*$" }
          },
          "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "changes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "content"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "content": { "type": "string", "minLength": 1 },
                "reason": { "type": "string", "minLength": 1 }
              }
            }
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200
          }
        }
      },
      "http": { "method": "POST", "path": "/v1/sessions/{id}/promotions" }
    },
    {
      "name": "akp_search",
      "version": "1.0.0",
      "permission": "knowledge:read",
      "mutates": false,
      "inputSchema": { "$ref": "#/definitions/ScopedSearch" },
      "http": { "method": "POST", "path": "/v1/search" }
    },
    {
      "name": "akp_build_context",
      "version": "1.0.0",
      "permission": "knowledge:read",
      "mutates": false,
      "sideEffects": ["persists_context_packet"],
      "inputSchema": { "$ref": "#/definitions/ScopedContext" },
      "http": { "method": "POST", "path": "/v1/context" }
    },
    {
      "name": "akp_get_document",
      "version": "1.0.0",
      "permission": "knowledge:read",
      "mutates": false,
      "http": { "method": "GET", "path": "/v1/documents/{id}" }
    },
    {
      "name": "akp_get_source_evidence",
      "version": "1.0.0",
      "permission": "source:read",
      "mutates": false,
      "http": { "method": "GET", "path": "/v1/documents/{id}/evidence" }
    },
    {
      "name": "akp_get_context_pack",
      "version": "1.0.0",
      "permission": "knowledge:read",
      "mutates": false,
      "http": { "method": "GET", "path": "/v1/context-packs/{id}" }
    },
    {
      "name": "akp_get_generated_context_packet",
      "version": "1.0.0",
      "permission": "knowledge:read",
      "mutates": false,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["packetId"],
        "properties": {
          "packetId": { "type": "string", "format": "uuid" }
        }
      },
      "http": {
        "method": "GET",
        "path": "/v1/generated-context-packets/{id}"
      }
    },
    {
      "name": "akp_get_context_continuation",
      "version": "1.0.0",
      "permission": "knowledge:read",
      "mutates": false,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["packetId", "handle"],
        "properties": {
          "packetId": { "type": "string", "format": "uuid" },
          "handle": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      },
      "http": {
        "method": "GET",
        "path": "/v1/generated-context-packets/{id}/continuations/{handle}"
      }
    },
    {
      "name": "akp_analyze_impact",
      "version": "1.0.0",
      "permission": "knowledge:read",
      "mutates": false,
      "http": { "method": "GET", "path": "/v1/impact/{id}" }
    },
    {
      "name": "akp_submit_source",
      "version": "1.0.0",
      "permission": "source:write",
      "mutates": true,
      "requiresIdempotencyKey": true,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["spaceId", "vaultId", "sourceUri", "idempotencyKey"],
        "properties": {
          "spaceId": { "type": "string", "format": "uuid" },
          "vaultId": { "type": "string", "format": "uuid" },
          "sourceUri": { "type": "string", "minLength": 1 },
          "title": { "type": "string" },
          "mediaType": { "type": "string" },
          "expectedSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "idempotencyKey": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200
          }
        }
      },
      "http": { "method": "POST", "path": "/v1/ingest" }
    },
    {
      "name": "akp_ingest_status",
      "version": "1.0.0",
      "permission": "source:read",
      "mutates": false,
      "http": { "method": "GET", "path": "/v1/ingest/{id}" }
    },
    {
      "name": "akp_propose_knowledge_change",
      "version": "1.0.0",
      "permission": "knowledge:propose",
      "mutates": true,
      "requiresIdempotencyKey": true,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "spaceId",
          "vaultId",
          "summary",
          "path",
          "content",
          "reason",
          "idempotencyKey"
        ],
        "properties": {
          "spaceId": { "type": "string", "format": "uuid" },
          "vaultId": { "type": "string", "format": "uuid" },
          "summary": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "content": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "idempotencyKey": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200
          }
        }
      },
      "http": { "method": "POST", "path": "/v1/proposals" }
    },
    {
      "name": "akp_validate_draft",
      "version": "1.0.0",
      "permission": "knowledge:read",
      "mutates": false,
      "http": { "method": "GET", "path": "/v1/reviews/{id}" }
    },
    {
      "name": "akp_submit_review",
      "version": "1.0.0",
      "permission": "knowledge:propose",
      "mutates": true,
      "requiresIdempotencyKey": true,
      "http": { "method": "POST", "path": "/v1/reviews/{id}/submit" }
    },
    {
      "name": "akp_revise_review",
      "version": "1.0.0",
      "permission": "knowledge:propose",
      "mutates": true,
      "requiresIdempotencyKey": true,
      "description": "Create a new validated Git draft revision after review feedback.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reviewId",
          "summary",
          "path",
          "content",
          "reason",
          "idempotencyKey"
        ],
        "properties": {
          "reviewId": { "type": "string", "format": "uuid" },
          "summary": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "content": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "idempotencyKey": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200
          }
        }
      },
      "http": { "method": "POST", "path": "/v1/reviews/{id}/revise" }
    },
    {
      "name": "akp_approve_review",
      "version": "1.0.0",
      "permission": "knowledge:review",
      "mutates": true,
      "requiresIdempotencyKey": true,
      "http": { "method": "POST", "path": "/v1/reviews/{id}/decision" }
    },
    {
      "name": "akp_reject_review",
      "version": "1.0.0",
      "permission": "knowledge:review",
      "mutates": true,
      "requiresIdempotencyKey": true,
      "http": { "method": "POST", "path": "/v1/reviews/{id}/decision" }
    },
    {
      "name": "akp_run_eval",
      "version": "1.0.0",
      "permission": "eval:run",
      "mutates": true,
      "requiresIdempotencyKey": true,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["spaceId", "vaultId", "idempotencyKey"],
        "properties": {
          "spaceId": { "type": "string", "format": "uuid" },
          "vaultId": { "type": "string", "format": "uuid" },
          "evalPack": { "type": "string", "default": "generic" },
          "idempotencyKey": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200
          }
        }
      },
      "http": { "method": "POST", "path": "/v1/evals/run" }
    },
    {
      "name": "akp_reindex",
      "version": "1.0.0",
      "permission": "admin",
      "mutates": true,
      "requiresIdempotencyKey": true,
      "description": "Rebuild one explicitly selected authorized vault; admin pathPrefix must be null.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["spaceId", "vaultId", "confirm", "idempotencyKey"],
        "properties": {
          "spaceId": { "type": "string", "format": "uuid" },
          "vaultId": { "type": "string", "format": "uuid" },
          "confirm": {
            "type": "string",
            "enum": ["REBUILD_DERIVED_PROJECTIONS", "REIMPORT_AND_REBUILD"]
          },
          "reimportVault": { "type": "boolean", "default": false },
          "idempotencyKey": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "reimportVault": { "const": true } },
              "required": ["reimportVault"]
            },
            "then": {
              "properties": {
                "confirm": { "const": "REIMPORT_AND_REBUILD" }
              }
            }
          },
          {
            "if": {
              "anyOf": [
                { "not": { "required": ["reimportVault"] } },
                {
                  "properties": { "reimportVault": { "const": false } },
                  "required": ["reimportVault"]
                }
              ]
            },
            "then": {
              "properties": {
                "confirm": { "const": "REBUILD_DERIVED_PROJECTIONS" }
              }
            }
          }
        ]
      },
      "http": { "method": "POST", "path": "/v1/reindex" }
    },
    {
      "name": "akp_benchmark_retrieval",
      "version": "1.0.0",
      "permission": "eval:run",
      "mutates": true,
      "requiresIdempotencyKey": true,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["spaceId", "vaultId", "idempotencyKey"],
        "properties": {
          "spaceId": { "type": "string", "format": "uuid" },
          "vaultId": { "type": "string", "format": "uuid" },
          "evalPack": { "type": "string", "default": "generic" },
          "idempotencyKey": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200
          }
        }
      },
      "http": { "method": "POST", "path": "/v1/evals/benchmark" }
    },
    {
      "name": "akp_export_audit_bundle",
      "version": "1.0.0",
      "permission": "admin",
      "mutates": false,
      "description": "Return bounded audit-bundle revision/count/hash metadata; ZIP content is delivered only through authenticated HTTP or explicit-root CLI export.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["vaultId", "confirm"],
        "properties": {
          "vaultId": { "type": "string", "format": "uuid" },
          "confirm": {
            "type": "string",
            "const": "EXPORT_SANITIZED_AUDIT_BUNDLE"
          }
        }
      },
      "http": {
        "method": "GET",
        "path": "/v1/audit/export/{vaultId}/metadata"
      }
    }
  ]
}
