{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akp.local/schemas/knowledge-document.json",
  "type": "object",
  "required": ["type", "status", "knowledge_layer"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "type": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "status": {"type": "string"},
    "knowledge_layer": {
      "enum": [
        "CANONICAL_RAW",
        "NORMALIZED",
        "EVIDENCE",
        "COMPILED",
        "OPERATIONAL",
        "NORMATIVE",
        "SCHEMA"
      ]
    },
    "verified": {
      "enum": ["UNVERIFIED", "MACHINE_SUPPORTED", "HUMAN_REVIEWED", "ATTESTED"]
    },
    "sources": {"type": "array"},
    "relations": {"type": "array"},
    "akp": {
      "type": "object",
      "properties": {
        "schema_version": {"type": "string"},
        "approval_required": {"type": "boolean"},
        "estimated_tokens": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
