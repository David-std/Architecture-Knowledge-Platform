NODE_ENV=development
PORT=8080
AKP_API_URL=http://127.0.0.1:8080
NEXT_PUBLIC_AKP_API_URL=http://127.0.0.1:8080
DATABASE_URL=postgres://akp:akp@localhost:55432/akp
AKP_POSTGRES_PORT=55432
AKP_VAULT_PATH=../example-knowledge-vault
AKP_RAW_ENDPOINT=http://127.0.0.1:19000
AKP_MINIO_API_PORT=19000
AKP_MINIO_CONSOLE_PORT=19001
AKP_RAW_BUCKET=akp-raw
AKP_RAW_ACCESS_KEY=akp
AKP_RAW_SECRET_KEY=change-me
AKP_EXTRACTOR_URL=http://localhost:8090
AKP_GIT_AUTHOR_NAME=Architecture Knowledge Platform
AKP_GIT_AUTHOR_EMAIL=akp@localhost
AKP_VECTOR_ENABLED=false
# Optional, measured passage scope. body-v1 preserves current inputs; changing
# this recipe requires rebuilding a new embedding generation before activation.
AKP_EMBEDDING_PASSAGE_CONTEXT=body-v1
AKP_LLM_PROVIDER=disabled
AKP_MANAGED_REPO=
AKP_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
AKP_COOKIE_SECURE=false
AKP_RATE_LIMIT_MAX=120
AKP_LINT_INTERVAL_MS=86400000
AKP_API_TOKEN=replace-with-at-least-24-random-characters
# Required by `pnpm auth:provision`.  Keep the permission list and optional
# `pathPrefix` as narrow as the local integration needs.
AKP_API_TOKEN_SCOPES={"spaces":[{"spaceId":"00000000-0000-0000-0000-000000000003","pathPrefix":null,"permissions":["knowledge:read","source:read"]}]}
AKP_INGEST_ROOTS=C:\path\to\captured-sources
AKP_PROJECT_ROOTS=C:\path\to\approved-projects
AKP_EXTRACTOR_TOKEN=replace-with-a-random-local-secret

# OpenTelemetry is optional. The platform remains usable when both exporters
# are disabled. Enable the Compose 'observability' profile and switch the
# exporters to 'otlp' to send traces/metrics to the local Collector.
OTEL_TRACES_EXPORTER=none
OTEL_METRICS_EXPORTER=none
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=local,service.namespace=akp
# OTEL_METRIC_EXPORT_INTERVAL=60000
AKP_OTEL_GRPC_PORT=4317
AKP_OTEL_HTTP_PORT=4318
AKP_OTEL_HEALTH_PORT=13133

# Evidence diagnostics. A contextual cross-encoder scores relevance, which
# does not prove that a passage answers. It is SHADOW-only; see
# docs/guides/retrieval-context-engineering.md. Disabled by default.
# AKP_EVIDENCE_VERIFIER_PROVIDER=contextual-cross-encoder
# AKP_EVIDENCE_VERIFIER_MODE=SHADOW
# AKP_EVIDENCE_VERIFIER_MIN_SCORE=0.2
# AKP_EVIDENCE_VERIFIER_MAX_CANDIDATES=32
# AKP_MODEL_CACHE_DIR=C:\path\to\model-cache
# Two-stage variant: the cross-encoder shortlists and a language model behind an
# OpenAI-compatible endpoint must quote the passage text that answers.
# AKP_EVIDENCE_VERIFIER_PROVIDER=cross-encoder-reader
# AKP_EVIDENCE_VERIFIER_MODE=ENFORCE
# AKP_EVIDENCE_READER_BASE_URL=http://127.0.0.1:11434
# AKP_EVIDENCE_READER_MODEL=
# AKP_EVIDENCE_READER_SHORTLIST=4
# Layered admission: the structural guard, structured propositions and the
# reader are the only admission authority; lexical passage heuristics never
# admit and reader failures fail closed. Requires the reader settings above.
# AKP_EVIDENCE_VERIFIER_MODE=LAYERED
# AKP_EVIDENCE_ADMISSION_TIMEOUT_MS=25000
# Hosted OpenAI-compatible readers receive passages and queries.
# AKP_EVIDENCE_READER_API_KEY=
# AKP_EVIDENCE_READER_JSON_RESPONSE_FORMAT=true
